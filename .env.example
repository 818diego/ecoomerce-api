# SERVER
PORT=3000
NODE_ENV=development
# CORS: un origen, varios separados por coma, o * para permitir cualquiera
# Ej. producción: CORS_ORIGIN=https://mitienda.com,https://www.mitienda.com
CORS_ORIGIN=http://localhost:4200

# DATABASE (MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ecommerce_db
DB_SYNCHRONIZE=true
DB_LOGGING=true

# JWT
JWT_SECRET=cambia-esto-por-una-clave-segura
JWT_EXPIRES_IN=1d